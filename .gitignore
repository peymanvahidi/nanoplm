.venv/
# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Jupyter Notebook
.ipynb_checkpoints

# VS Code
.vscode/

# PyCharm
.idea/

# Environment files
.env
.envrc

# Logs
logs/
*.log

# Data (consider what you want to track with DVC vs git)
data/*
!data/.gitkeep

# Model files
*.pt
*.pth
*.h5
*.ckpt
*.bin

# UV package manager
.uv/
uv.lock

# Outputs
output/

# Macos artifacts
.DS_Store

# experiments
experiments/

# wandb
wandb/

# Coverage reports
.coverage
coverage.xml
htmlcov/
.pytest_cache/

scripts/

# Planning directory (local only)
.planning/

# Root-level scratch docs dir only. NOT anchored = would also match
# website/src/content/docs/, which is the actual documentation source.
/docs/

# Local extension build cache
.cache/
agent_space/
CLAUDE.md
CLAUDE.local.md
AGENTS.md

# Docs site (Astro/Starlight)
node_modules/
website/.astro/*

# Eval / benchmark run output (autoeval_output_jul22_pbc_max512 alone is ~45G)
autoeval_output*/

# Third-party clones kept beside the repo for development.
# NB: a `dion/` directory at the repo root shadows the installed dion package
# (cwd precedes site-packages on sys.path), which makes dion expose nothing.
dion/
gram-newton-schulz/
old_baseline_src/

# Generated run configs and cluster scratch
/pretrain.yaml
/pretrain_abl_baseline.yaml
hold_*.sh
sbatch_*.sh
claude-*.sh
Screenshot*.png

# Local-only notes and tooling (kept out of the repo on purpose)
canon_cutedsl.md
te_cpu_act_offload.md
a2a_nvlink_sweep_prompt.md
wandb_sync_daemon.*
