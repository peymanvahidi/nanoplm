---
// website/src/components/ReferenceTable.astro
// Renders one config surface (optionally one section of it) as a scannable
// reference table, sourced from the generated JSON Schema via toRows().
// The distill surface is still generated (the parity gate keeps it honest), but it
// is deliberately not rendered: distillation is unmaintained and gets one prose
// page, not a reference table.
import { toRows, type Surface } from '../lib/schema';
import data from '../generated/nanoplm.data.schema.json';
import pretrain from '../generated/nanoplm.pretrain.schema.json';
import evalSchema from '../generated/nanoplm.eval.schema.json';

interface Props {
  surface: 'data' | 'pretrain' | 'eval';
  section?: string;
}

const { surface, section } = Astro.props;

const SCHEMAS: Record<Props['surface'], Surface> = {
  data: data as Surface,
  pretrain: pretrain as Surface,
  eval: evalSchema as Surface,
};

const rows = toRows(SCHEMAS[surface], section);
const prefix = section ? `${surface}-${section}` : surface;
const hasAdvanced = rows.some((r) => r.advanced);

function fmtDefault(value: unknown): string {
  if (typeof value === 'string') return value;
  return JSON.stringify(value);
}
---

<div class="ref-table-wrap">
  {hasAdvanced && (
    <label class="ref-adv-toggle">
      <input type="checkbox" /> Show advanced fields
    </label>
  )}
  <table class="ref-table">
    <thead>
      <tr>
        <th>Field</th>
        <th>Type</th>
        <th>Default</th>
        <th>Allowed</th>
        <th>Backend</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr id={`${prefix}-${r.key}`} class={r.advanced ? 'ref-advanced' : undefined}>
          <td>
            <code>{r.key}</code>{r.required && <span class="ref-req" title="required (no default)">&nbsp;*</span>}
          </td>
          <td><code>{r.type}</code></td>
          <td>{r.default === undefined ? <span class="ref-muted">—</span> : <code>{fmtDefault(r.default)}</code>}</td>
          <td>{r.enum ? <code>{r.enum.map(String).join(' | ')}</code> : <span class="ref-muted">—</span>}</td>
          <td>{r.backend ? r.backend.join(', ') : <span class="ref-muted">—</span>}</td>
          <td>{r.description ?? ''}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .ref-table-wrap { overflow-x: auto; margin: 0.5rem 0 1.5rem; }
  .ref-table { width: 100%; font-size: 0.875rem; border-collapse: collapse; }
  .ref-table th { text-align: left; white-space: nowrap; }
  .ref-table td { vertical-align: top; }
  .ref-muted { color: var(--sl-color-gray-4); }
  .ref-req { color: var(--sl-color-accent); font-weight: 700; }
  .ref-adv-toggle {
    display: inline-flex; gap: 0.4rem; align-items: center;
    font-size: 0.8rem; color: var(--sl-color-gray-3); margin-bottom: 0.5rem; cursor: pointer;
  }
  /* CSS-only advanced toggle: hide advanced rows unless the checkbox is checked. */
  .ref-table-wrap:has(.ref-adv-toggle input:not(:checked)) .ref-advanced { display: none; }
</style>
