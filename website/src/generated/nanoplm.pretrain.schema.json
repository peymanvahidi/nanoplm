{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-nanoplm-surface": "pretrain",
  "type": "object",
  "properties": {
    "model": {
      "type": "object",
      "properties": {
        "hidden_size": {
          "type": "integer",
          "default": 1024
        },
        "intermediate_size": {
          "type": "integer",
          "default": 2048
        },
        "num_hidden_layers": {
          "type": "integer",
          "default": 16
        },
        "num_attention_heads": {
          "type": "integer",
          "default": 16
        },
        "num_kv_heads": {
          "type": "integer",
          "default": 8,
          "description": "GQA; equal to num_attention_heads = MHA"
        },
        "vocab_size": {
          "type": "integer",
          "default": 32
        },
        "norm_type": {
          "type": "string",
          "default": "rmsnorm",
          "enum": [
            "layernorm",
            "rmsnorm"
          ],
          "description": "layernorm | rmsnorm  (rmsnorm: slightly faster, no bias)"
        },
        "mlp_activation": {
          "type": "string",
          "default": "swiglu",
          "enum": [
            "swiglu",
            "glu",
            "srelu"
          ],
          "description": "swiglu | glu | srelu"
        },
        "mlp_dropout": {
          "type": "number",
          "default": 0.0
        },
        "mlp_bias": {
          "type": "boolean",
          "default": false
        },
        "no_mlp_on_first_layer": {
          "type": "boolean",
          "default": false
        },
        "attention_bias": {
          "type": "boolean",
          "default": false
        },
        "attention_dropout": {
          "type": "number",
          "default": 0.0
        },
        "classifier_activation": {
          "type": "string",
          "default": "gelu",
          "enum": [
            "relu",
            "gelu",
            "srelu"
          ],
          "description": "relu | gelu | srelu  (srelu: pure_torch / pure_te)"
        },
        "tie_word_embeddings": {
          "type": "boolean",
          "default": false,
          "description": "share input embedding \u2194 output decoder weights"
        },
        "use_qk_norm": {
          "type": "boolean",
          "default": false,
          "description": "Available on pure_torch and pure_te unless a feature banner says otherwise. RMS-norm Q and K in attention"
        },
        "reorder_RoPE_QKNorm": {
          "type": "boolean",
          "default": false,
          "description": "true = norm BEFORE RoPE (LLaMA-style, better fusion); needs use_qk_norm"
        },
        "use_resid_lambdas": {
          "type": "boolean",
          "default": false,
          "description": "per-layer residual scale; incompatible with use_mhc_lite"
        },
        "use_x0_lambdas": {
          "type": "boolean",
          "default": false,
          "description": "blend initial embedding x0 into each layer"
        },
        "global_rope_theta": {
          "type": "number",
          "default": 40000.0,
          "description": "RoPE base for full-attention layers; lower (10k\u201340k) suits short max_seq_len"
        },
        "local_rope_theta": {
          "type": "number",
          "default": 10000.0,
          "description": "RoPE base for sliding-window layers"
        },
        "rope_dim_fraction": {
          "type": "number",
          "default": 1.0,
          "description": "fraction of head_dim that is rotary (e.g. 0.25 = 25% RoPE + 75% NoPE)"
        },
        "attn_layer_pattern": {
          "type": "string",
          "default": "F",
          "description": "F=full, S=sliding; tiles over num_layers (e.g. 'FSS')"
        },
        "fused_qkv": {
          "type": "boolean",
          "default": true,
          "description": "false = separate Wq / Wk / Wv"
        },
        "fused_up_gate": {
          "type": "boolean",
          "default": true,
          "description": "false = separate W_up / W_gate (SwiGLU/GLU)"
        },
        "wo_init": {
          "type": "string",
          "default": "kaiming",
          "enum": [
            "kaiming",
            "zero"
          ],
          "description": "residual out-proj init: kaiming | zero (muonh forbids zero)"
        },
        "use_canon_layers": {
          "type": "boolean",
          "default": false,
          "description": "Canon-ABCD local mixing layers",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "canon_layers_mode": {
          "type": "string",
          "default": "ac",
          "description": "subset of sites A/B/C/D  (e.g. \"ac\" = lighter)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_canon_layers",
            "op": "==",
            "value": true
          }
        },
        "canon_layers_kernel_size": {
          "type": "integer",
          "default": 5,
          "enum": [
            3,
            5,
            7
          ],
          "description": "3 | 5 | 7",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_canon_layers",
            "op": "==",
            "value": true
          }
        },
        "use_repo": {
          "type": "boolean",
          "default": false,
          "description": "learned per-head positions instead of fixed RoPE",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "repo_after_n_layers": {
          "type": "integer",
          "default": 3,
          "description": "first N layers keep standard RoPE; rest use RePO",
          "x-nanoplm-visible-when": {
            "field": "use_repo",
            "op": "==",
            "value": true
          }
        },
        "use_prores": {
          "type": "boolean",
          "default": false,
          "description": "progressive residual warmup (deeper layers slower)"
        },
        "prores_T": {
          "type": "integer",
          "default": 1000,
          "description": "warmup length for layer 0; layer l ends at step T*l",
          "x-nanoplm-visible-when": {
            "field": "use_prores",
            "op": "==",
            "value": true
          }
        },
        "use_mhc_lite": {
          "type": "boolean",
          "default": false,
          "description": "Multi-stream residual with doubly stochastic mixing. Incompatible with use_resid_lambdas.",
          "x-nanoplm-backend": [
            "pure_torch",
            "pure_te"
          ],
          "x-nanoplm-advanced": true
        },
        "mhc_n_streams": {
          "type": "integer",
          "default": 4,
          "description": "residual streams (n! permutation matrices)",
          "x-nanoplm-visible-when": {
            "field": "use_mhc_lite",
            "op": "==",
            "value": true
          }
        },
        "mhc_lite_wrapping_level": {
          "type": "string",
          "default": "layer",
          "enum": [
            "layer",
            "sublayers"
          ],
          "description": "layer | sublayers",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_mhc_lite",
            "op": "==",
            "value": true
          }
        },
        "mhc_triton_fused": {
          "type": "boolean",
          "default": true,
          "description": "fused Triton stream ops; first run slow (autotune)",
          "x-nanoplm-visible-when": {
            "field": "use_mhc_lite",
            "op": "==",
            "value": true
          }
        },
        "use_diff_attn_v2": {
          "type": "boolean",
          "default": false,
          "description": "DiffAttn V2: doubles Q heads + differential subtract",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "use_paired_head_attention": {
          "type": "boolean",
          "default": false,
          "description": "pair adjacent heads \u2192 shared softmax; MHA only; incompatible with diff_attn_v2, RePO, Canon-B",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "use_noble": {
          "type": "boolean",
          "default": false,
          "description": "Nonlinear low-rank branches on linear layers. Training LR scaling lives under pretraining.noble_* (active when use_noble).",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "noble_rank": {
          "type": "integer",
          "default": 64,
          "description": "bottleneck rank (typical 64\u2013256)",
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_alpha": {
          "type": "number",
          "default": 0.01,
          "description": "W_up initialization scale",
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_half_kaiming": {
          "type": "boolean",
          "default": true,
          "description": "halve main weight init scale (paper \u00a73.3)",
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_targets": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "attn",
            "ffn",
            "qkv",
            "out"
          ],
          "description": "all | attn | ffn | qkv | out",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "activation_checkpointing": {
          "type": "boolean",
          "default": false,
          "description": "recompute activations in backward \u2192 less VRAM"
        },
        "activation_checkpointing_mode": {
          "type": "string",
          "default": "attn",
          "enum": [
            "layer",
            "attn",
            "attn+mlp"
          ],
          "description": "layer | attn | attn+mlp   (attn = highest ROI)"
        },
        "use_moe": {
          "type": "boolean",
          "default": false,
          "description": "Requires: pretraining.use_packing: true  and  use_static_inp_size: true Always-on: one shared expert; routing is always sigmoid.",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "moe_num_experts": {
          "type": "integer",
          "default": 8,
          "description": "routed experts",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_top_k": {
          "type": "integer",
          "default": 2,
          "description": "experts activated per token",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_use_bias_correction": {
          "type": "boolean",
          "default": true,
          "description": "expert-bias load balancing (selection-only)",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_aux_loss_coef": {
          "type": "number",
          "default": 0.01,
          "description": "differentiable balance regularizer (router mass)",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_z_loss_coef": {
          "type": "number",
          "default": 5e-05,
          "description": "router z-loss (small-model MoE stability)",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_routed_scaling_factor": {
          "type": "number",
          "default": 1.0,
          "description": "routed branch output scale; start conservative",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_n_group": {
          "type": "integer",
          "default": 1,
          "description": "group-limited routing: 1 = off; >1 = partitions",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_topk_group": {
          "type": "integer",
          "default": 1,
          "description": "when moe_n_group > 1: keep top-K groups / token",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_bias_update_rate": {
          "type": "number",
          "default": 0.001,
          "description": "expert-bias correction step size",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_leading_dense_layers": {
          "type": "integer",
          "default": 1,
          "description": "first N layers stay dense (DeepSeek uses 1)",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_kernel_backend": {
          "type": "string",
          "default": "sonicmoe",
          "description": "cutlass | sonicmoe  (SonicMoE/quack fused path)"
        },
        "recycling_num_prelude_layers": {
          "type": "integer",
          "default": 0,
          "description": "recycling_loop_count: 1  \u2192  recycling OFF (default). Splits the L-layer stack into: prelude  P  \u2014 first P layers, run once recurrent   \u2014 layers P .. L-C-1, weight-tied and looped coda     C  \u2014 last C layers, run once A learned 2h\u2192h adapter consumes [s, e] at each recycling iteration. Training-time knobs live under pretraining.recycling_* (when recycling_loop_count > 1). P",
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_num_coda_layers": {
          "type": "integer",
          "default": 0,
          "description": "C",
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_loop_count": {
          "type": "integer",
          "default": 1,
          "description": "target mean loop count (1 = off)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "recycling_adapter_bias": {
          "type": "boolean",
          "default": false,
          "description": "bias on 2h\u2192h adapter (Huginn: no bias)",
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_s0_noise_sigma": {
          "type": "number",
          "default": 0.6324555320336759,
          "description": "sqrt(2/5) \u2014 Huginn s\u2080 noise scale",
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_use_takase_init": {
          "type": "boolean",
          "default": true,
          "description": "Takase spike init on recurrent block + adapter",
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        }
      }
    },
    "pretraining": {
      "type": "object",
      "properties": {
        "dataset_dir": {
          "type": "string",
          "default": "output/data/pretrain_data"
        },
        "ckp_dir": {
          "type": "string",
          "default": "output/pretraining_checkpoints"
        },
        "project_name": {
          "type": "string",
          "default": "nanoplm-pretraining"
        },
        "run_name": {
          "type": "string",
          "default": "run",
          "description": "on-disk name: DDMMHHMM-<run_name>"
        },
        "micro_batch_seqs": {
          "type": "integer",
          "default": 128,
          "description": "micro_batch_seqs     = sequences per GPU per forward  (the VRAM knob) global_batch_tokens  = tokens per optimizer step Gradient accumulation is inferred from those two + manifest seq_len + world_size. You never set grad_accum yourself."
        },
        "global_batch_tokens": {
          "type": "integer",
          "default": 1024000
        },
        "global_batch_warmup_steps": {
          "type": "integer",
          "default": 0,
          "description": "Ramp global batch: 1/8 \u2192 1/4 \u2192 1/2 \u2192 full, reaching full at this step. 0 = disabled (no batch-size warmup)."
        },
        "lr_schedule": {
          "type": "string",
          "default": "wsd",
          "enum": [
            "wsd",
            "warmup_stable",
            "cosine",
            "linear"
          ],
          "description": "Token budget, not epochs. lr_schedule: wsd set stable_tokens + decay_tokens stable_tokens INCLUDES warmup \u2014 it is the point where decay begins, not a length added after warmup. decay_tokens IS a length after that. lr_schedule: warmup_stable | cosine | linear comment out stable_tokens / decay_tokens; uncomment train_tokens warmup_steps is used by ALL schedules. Prefer tokens over steps. Step overrides (below) replace their *_tokens twin \u2014 never set both of a pair. wsd | warmup_stable | cosine | linear"
        },
        "warmup_steps": {
          "type": "integer",
          "default": 1000
        },
        "stable_tokens": {
          "type": "integer",
          "default": 9000000,
          "description": "wsd only: tokens up to the pre-decay checkpoint (warmup included)"
        },
        "decay_tokens": {
          "type": "integer",
          "default": 1000000,
          "description": "wsd only: additional anneal tokens"
        },
        "decay_shape": {
          "type": "string",
          "default": "1-sqrt",
          "enum": [
            "1-sqrt",
            "linear"
          ],
          "description": "1-sqrt | linear"
        },
        "lr_decay_to_fraction": {
          "type": "number",
          "default": 0.1
        },
        "optimizer": {
          "type": "string",
          "default": "normuon",
          "enum": [
            "adamw",
            "stable_adamw",
            "muon",
            "normuon",
            "muonh",
            "aurora"
          ],
          "description": "adam_* also drives the AdamW side (1D params + embeddings/unembed) when optimizer is muon | normuon | muonh | aurora. adamw | stable_adamw | muon | normuon | muonh | aurora"
        },
        "adam_beta1": {
          "type": "number",
          "default": 0.9
        },
        "adam_beta2": {
          "type": "number",
          "default": 0.95
        },
        "adam_epsilon": {
          "type": "number",
          "default": 1e-08
        },
        "adam_learning_rate": {
          "type": "number",
          "default": 0.0001
        },
        "adam_weight_decay": {
          "type": "number",
          "default": 0.0
        },
        "max_grad_norm": {
          "type": "integer",
          "default": 1
        },
        "muon_learning_rate": {
          "type": "number",
          "default": 0.001
        },
        "muon_weight_decay": {
          "type": "number",
          "default": 0.01
        },
        "muon_cautious_weight_decay": {
          "type": "boolean",
          "default": true
        },
        "muon_use_polar_express": {
          "type": "boolean",
          "default": true
        },
        "muon_momentum": {
          "type": "number",
          "default": 0.95
        },
        "muon_nesterov": {
          "type": "boolean",
          "default": true
        },
        "muon_eps": {
          "type": "number",
          "default": 1e-07
        },
        "muonh_normalization": {
          "type": "string",
          "default": "neuron",
          "enum": [
            "neuron",
            "short_axis",
            "none"
          ],
          "description": "muonh only: neuron | short_axis | none"
        },
        "muonh_scope": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "mlp"
          ],
          "description": "muonh|aurora: all = all matrices; mlp = MLP only (rest on NorMuon)"
        },
        "repo_rope_warmup_steps": {
          "type": "integer",
          "default": 1000,
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "noble_base_lr": {
          "type": "number",
          "default": 0.0003,
          "description": "independent base LR for NOBLE branch params",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_lr_gamma": {
          "type": "number",
          "default": 0.3,
          "description": "W_up LR power  (actual exponent = 2\u03b3 = 0.6)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_lr_gamma_M": {
          "type": "number",
          "default": 0.45,
          "description": "M mixing-matrix LR power",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_freq_lr_mult": {
          "type": "number",
          "default": 3.0,
          "description": "\u03c9 frequency LR multiplier",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_phase_lr_mult": {
          "type": "number",
          "default": 5.0,
          "description": "\u03c6 phase LR multiplier",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "recycling_bptt": {
          "type": "integer",
          "default": 8,
          "description": "truncated BPTT depth K (last K iters get grads)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_loop_count_sampling": {
          "type": "string",
          "default": "lognormal_poisson",
          "enum": [
            "fixed",
            "lognormal_poisson"
          ],
          "description": "fixed | lognormal_poisson",
          "x-nanoplm-backend": [
