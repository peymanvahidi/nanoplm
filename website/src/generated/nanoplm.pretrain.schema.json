          "default": 0.1,
          "description": "REQUIRED for mode: decay"
        },
        "decay_steps": {
          "type": "integer",
          "default": null,
          "description": "(mode: decay) Step-based override for resume.decay_tokens: number of additional anneal optimizer steps to run from the checkpoint. Set exactly one of decay_tokens or decay_steps, never both. mode: continue accepts no decay_* field at all.",
