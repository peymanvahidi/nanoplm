  "x-nanoplm-compat": {
    "trigger": "recycling_loop_count > 1",
    "feature": "huggin_style_recycling",
    "model_reject": [
      {
        "flag": "use_moe",
        "reason": "MoE per-layer state (last_expert_counts, last_aux_loss) is overwritten on every recurrent iteration; only the last iteration's routing decisions would reach the pipeline's expert-bias correction. Disable use_moe or recycling_loop_count > 1.",
        "condition": ""
      },
      {
        "flag": "use_x0_lambdas",
        "reason": "x0 captured once before the loop; per-physical-layer rescaling re-applied every recurrent iteration has unvalidated semantics.",
        "condition": ""
      },
      {
        "flag": "use_resid_lambdas",
        "reason": "Per-physical-layer residual scaling re-applied every iteration has unvalidated semantics; likely interacts with adapter + noise s_0.",
        "condition": ""
      },
      {
        "flag": "use_mhc_lite",
        "reason": "mHC-lite multi-stream residual mixing has its own stability guarantees (doubly-stochastic mixing); interaction with the recycled residual stream is untested.",
        "condition": ""
      }
    ],
    "model_warn": [
      {
        "flag": "use_repo",
        "message": "RePO will re-predict per-head positions every recurrent iteration. This hasn't been ablated; consider setting repo_after_n_layers >= recycling_num_prelude_layers + (num_hidden_layers - recycling_num_prelude_layers - recycling_num_coda_layers) so RePO stays in the coda.",
        "condition": "repo_after_n_layers falls inside the recurrent block region"
      }
    ],
    "model_allow": [
      "use_qk_norm",
      "use_canon_layers",
      "use_noble",
      "use_diff_attn_v2",
      "use_paired_head_attention",
      "use_prores",
      "fused_qkv",
      "fused_up_gate",
      "wo_init",
      "activation_checkpointing",
      "attn_layer_pattern"
    ],
    "pipeline_reject": [
      {
        "flag": "pure_te",
        "reason": "te_pipeline.py is out of scope for the v1 recycling implementation. Use pure_torch.",
        "condition": "pure_te is True"
      },
      {
        "flag": "pure_torch",
        "reason": "Recycling lands only in pure_pipeline.py for v1; the HF path is out of scope.",
        "condition": "pure_torch is False"
      }
    ],
    "pipeline_caveat": [
      {
        "flag": "fp8",
        "message": "fp8 + truncated BPTT gradient correctness is not validated. Disable unless you have a specific reason.",
        "condition": "fp8 is True"
      },
      {
        "flag": "use_compile_max_autotune",
        "message": "Recycled forward must compile the recurrent STEP, not unroll the loop. Enabling compile triggers an additional smoke test.",
        "condition": "use_compile_max_autotune is True"
      }
    ],
    "pipeline_allow": [
      "distributed_mode",
      "bf16",
      "tf32",
      "multi_gpu",
      "lr_schedule",
      "global_batch_warmup_steps",
      "activation_checkpointing"
    ]
  }
}
