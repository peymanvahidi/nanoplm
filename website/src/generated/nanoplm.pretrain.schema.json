{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-nanoplm-surface": "pretrain",
  "type": "object",
  "properties": {
    "model": {
      "type": "object",
      "properties": {
        "hidden_size": {
          "type": "integer",
          "default": 768
        },
        "intermediate_size": {
          "type": "integer",
          "default": 1536
        },
        "num_hidden_layers": {
          "type": "integer",
          "default": 12
        },
        "num_attention_heads": {
          "type": "integer",
          "default": 8
        },
        "vocab_size": {
          "type": "integer",
          "default": 32
        },
        "norm_type": {
          "type": "string",
          "default": "layernorm",
          "enum": [
            "layernorm",
            "rmsnorm"
          ],
          "description": "layernorm | rmsnorm (rmsnorm is slightly faster, no bias)"
        },
        "mlp_activation": {
          "type": "string",
          "default": "swiglu",
          "enum": [
            "swiglu",
            "glu",
            "srelu"
          ],
          "description": "swiglu | glu | srelu"
        },
        "mlp_dropout": {
          "type": "number",
          "default": 0.0
        },
        "mlp_bias": {
          "type": "boolean",
          "default": false
        },
        "no_mlp_on_first_layer": {
          "type": "boolean",
          "default": true
        },
        "attention_bias": {
          "type": "boolean",
          "default": false
        },
        "attention_dropout": {
          "type": "number",
          "default": 0.0
        },
        "classifier_activation": {
          "type": "string",
          "default": "gelu",
          "enum": [
            "relu",
            "gelu",
            "srelu"
          ],
          "description": "relu | gelu | srelu (srelu requires pure_torch or pure_te)"
        },
        "tie_word_embeddings": {
          "type": "boolean",
          "default": true,
          "description": "tie input embedding and output decoder weights"
        },
        "use_resid_lambdas": {
          "type": "boolean",
          "default": false,
          "description": "The options below only work on pure-torch and TE pipelines unless noted scales residual stream per layer (not compatible with use_mhc_lite)"
        },
        "use_x0_lambdas": {
          "type": "boolean",
          "default": false,
          "description": "blends initial embedding x0 per layer"
        },
        "use_qk_norm": {
          "type": "boolean",
          "default": false,
          "description": "applies RMS norm to Q/K in attention"
        },
        "reorder_RoPE_QKNorm": {
          "type": "boolean",
          "default": false,
          "description": "true = QK norm BEFORE RoPE (LLaMA-style, better fusion); needs use_qk_norm"
        },
        "global_rope_theta": {
          "type": "number",
          "default": 160000.0,
          "description": "RoPE base for full-attention layers; lower (e.g. 10000-40000) suits short max_seq_len"
        },
        "local_rope_theta": {
          "type": "number",
          "default": 10000.0,
          "description": "RoPE base for sliding-window layers"
        },
        "rope_dim_fraction": {
          "type": "number",
          "default": 1.0,
          "description": "fraction of head_dim to apply RoPE (e.g. 0.25 = 25% rotary + 75% NoPE content dims)"
        },
        "use_canon_layers": {
          "type": "boolean",
          "default": false,
          "description": "enables Canon-ABCD local mixing layers (pure_torch only)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "canon_layers_mode": {
          "type": "string",
          "default": "ac",
          "description": "subset of Canon sites: A/B/C/D (e.g. \"ac\" for lighter mode)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_canon_layers",
            "op": "==",
            "value": true
          }
        },
        "canon_layers_kernel_size": {
          "type": "integer",
          "default": 5,
          "enum": [
            3,
            5,
            7
          ],
          "description": "symmetric Canon kernel size (allowed: 3/5/7, default: 5)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_canon_layers",
            "op": "==",
            "value": true
          }
        },
        "use_repo": {
          "type": "boolean",
          "default": false,
          "description": "RePO: learned per-head positions replacing fixed RoPE (pure_torch only)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "repo_after_n_layers": {
          "type": "integer",
          "default": 3,
          "description": "first N layers keep standard RoPE, layers after use RePO",
          "x-nanoplm-visible-when": {
            "field": "use_repo",
            "op": "==",
            "value": true
          }
        },
        "use_prores": {
          "type": "boolean",
          "default": false,
          "description": "ProRes: progressive residual warmup (deeper layers warm up slower)"
        },
        "prores_T": {
          "type": "integer",
          "default": 1000,
          "description": "ProRes warmup length for first layer; layer l finishes at step T*l",
          "x-nanoplm-visible-when": {
            "field": "use_prores",
            "op": "==",
            "value": true
          }
        },
        "use_mhc_lite": {
          "type": "boolean",
          "default": false,
          "description": "mHC-lite: multi-stream residual with doubly stochastic mixing (pure_torch only)",
          "x-nanoplm-backend": [
            "pure_torch",
            "pure_te"
          ],
          "x-nanoplm-advanced": true
        },
        "mhc_n_streams": {
          "type": "integer",
          "default": 4,
          "description": "number of residual streams for mHC-lite (n! permutation matrices)",
          "x-nanoplm-visible-when": {
            "field": "use_mhc_lite",
            "op": "==",
            "value": true
          }
        },
        "mhc_lite_wrapping_level": {
          "type": "string",
          "default": "layer",
          "enum": [
            "layer",
            "sublayers"
          ],
          "description": "mHC-lite wrapping: 'layer' or 'sublayers' (pure_torch only)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_mhc_lite",
            "op": "==",
            "value": true
          }
        },
        "mhc_triton_fused": {
          "type": "boolean",
          "default": true,
          "description": "use fused Triton kernels for mHC-lite stream ops; first run will start slow due to Triton autotune",
          "x-nanoplm-visible-when": {
            "field": "use_mhc_lite",
            "op": "==",
            "value": true
          }
        },
        "use_diff_attn_v2": {
          "type": "boolean",
          "default": false,
          "description": "Differential Attention V2: doubles Q heads with differential subtraction (pure_torch only)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "use_paired_head_attention": {
          "type": "boolean",
          "default": false,
          "description": "pairs adjacent attention heads into a shared softmax (pure_torch only; MHA only; incompatible with diff_attn_v2, RePO, and Canon-B)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "use_noble": {
          "type": "boolean",
          "default": false,
          "description": "NOBLE: nonlinear low-rank branches for linear layers (pure_torch only)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "noble_rank": {
          "type": "integer",
          "default": 64,
          "description": "NOBLE bottleneck rank (typical: 64-256)",
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_alpha": {
          "type": "number",
          "default": 0.01,
          "description": "NOBLE W_up initialization scale",
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_half_kaiming": {
          "type": "boolean",
          "default": true,
          "description": "halve main weight init scale for NOBLE layers (paper \u00a73.3)",
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_targets": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "attn",
            "ffn",
            "qkv",
            "out"
          ],
          "description": "which projections get NOBLE: all|attn|ffn|qkv|out",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "attn_layer_pattern": {
          "type": "null",
          "default": null,
          "description": "Attention pattern string e.g. 'FSS' (F=full, S=sliding). Tiles to num_layers. Overrides global_attn_every_n_layers."
        },
        "fused_qkv": {
          "type": "boolean",
          "default": true,
          "description": "false = separate Wq/Wk/Wv instead of a single Wqkv"
        },
        "fused_up_gate": {
          "type": "boolean",
          "default": true,
          "description": "false = separate W_up/W_gate instead of a single Wi for SwiGLU/GLU"
        },
        "wo_init": {
          "type": "string",
          "default": "zero",
          "enum": [
            "kaiming",
            "zero"
          ],
          "description": "residual out-projection init for attn.Wo/mlp.Wo: kaiming | zero"
        },
        "activation_checkpointing": {
          "type": "boolean",
          "default": false,
          "description": "Enable to reduce VRAM by recomputing activations during backward"
        },
        "activation_checkpointing_mode": {
          "type": "string",
          "default": "attn",
          "enum": [
            "layer",
            "attn",
            "attn+mlp"
          ],
          "description": "(layer | attn | attn+mlp), attn mode has highest ROI"
        },
        "use_moe": {
          "type": "boolean",
          "default": false,
          "description": "MoE (Mixture-of-Experts) \u2014 pure_torch only, requires use_packing + use_static_inp_size",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "moe_num_experts": {
          "type": "integer",
          "default": 8,
          "description": "number of routed experts",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_top_k": {
          "type": "integer",
          "default": 2,
          "description": "experts activated per token",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_use_bias_correction": {
          "type": "boolean",
          "default": true,
          "description": "one shared expert is always enabled; routing is always sigmoid expert-bias load balancing (selection-only)",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_aux_loss_coef": {
          "type": "number",
          "default": 0.01,
          "description": "differentiable balance regularizer over router mass",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_z_loss_coef": {
          "type": "number",
          "default": 5e-05,
          "description": "router z-loss for small-model MoE stability",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_routed_scaling_factor": {
          "type": "number",
          "default": 1.0,
          "description": "routed branch output scale; start conservative",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_n_group": {
          "type": "integer",
          "default": 1,
          "description": "group-limited routing: 1 disables, >1 partitions experts into groups",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_topk_group": {
          "type": "integer",
          "default": 1,
          "description": "with moe_n_group > 1, keep top K groups per token",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_bias_update_rate": {
          "type": "number",
          "default": 0.001,
          "description": "expert-bias correction step size",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "moe_leading_dense_layers": {
          "type": "integer",
          "default": 1,
          "description": "first N layers are always dense (DeepSeek uses 1)",
          "x-nanoplm-visible-when": {
            "field": "use_moe",
            "op": "==",
            "value": true
          }
        },
        "recycling_num_prelude_layers": {
          "type": "integer",
          "default": 0,
          "description": "Huginn-style recycling \u2014 pure_torch only. recycling_loop_count: 1 disables recycling. Splits the L-layer stack into prelude (P, runs once) / recurrent (L-P-C, weight-tied, looped) / coda (C, runs once); a learned 2h->h adapter consumes [s, e] at each iter. P; first P layers run once",
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_num_coda_layers": {
          "type": "integer",
          "default": 0,
          "description": "C; last C layers run once",
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_loop_count": {
          "type": "integer",
          "default": 1,
          "description": "target mean loop count (1 = off)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "recycling_adapter_bias": {
          "type": "boolean",
          "default": false,
          "description": "bias on the 2h->h adapter (Huginn: no bias)",
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_s0_noise_sigma": {
          "type": "number",
          "default": 0.6324555320336759,
          "description": "sqrt(2/5), Huginn s_0 noise scale",
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_use_takase_init": {
          "type": "boolean",
          "default": true,
          "description": "Takase spike init on recurrent block + adapter",
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        }
      }
    },
    "pretraining": {
      "type": "object",
      "properties": {
        "dataset_dir": {
          "type": "string",
          "default": "output/data/pretrain_data"
        },
        "ckp_dir": {
          "type": "string",
          "default": "output/pretraining_checkpoints"
        },
        "micro_batch_seqs": {
          "type": "integer",
          "default": 64,
          "description": "Batch sizing (token-budget surface)"
        },
        "global_batch_tokens": {
          "type": "integer",
          "default": 256000
        },
        "global_batch_warmup_steps": {
          "type": "integer",
          "default": 0,
          "description": "number of steps to warm up to the target global batch size, starts at 1/8 -> 1/4 -> 1/2 -> full (at the provided step). default: 0, no batch size warmup."
        },
        "lr_schedule": {
          "type": "string",
          "default": "wsd",
          "enum": [
            "wsd",
            "warmup_stable",
            "cosine",
            "linear"
          ],
          "description": "Duration + LR schedule (token-budget surface) wsd | warmup_stable | cosine | linear"
        },
        "warmup_steps": {
          "type": "integer",
          "default": 1000
        },
        "stable_tokens": {
          "type": "integer",
          "default": 9000000,
          "description": "wsd: tokens up to the pre-decay checkpoint (warmup included)"
        },
        "decay_tokens": {
          "type": "integer",
          "default": 1000000,
          "description": "wsd: additional anneal tokens"
        },
        "decay_shape": {
          "type": "string",
          "default": "1-sqrt",
          "enum": [
            "1-sqrt",
            "linear"
          ],
          "description": "1-sqrt | linear"
        },
        "lr_decay_to_fraction": {
          "type": "number",
          "default": 0.1
        },
        "optimizer": {
          "type": "string",
          "default": "adamw",
          "enum": [
            "adamw",
            "stable_adamw",
            "muon",
            "normuon",
            "muonh",
            "aurora"
          ],
          "description": "adamw | stable_adamw | muon | normuon | muonh | aurora"
        },
        "adam_beta1": {
          "type": "number",
          "default": 0.9,
          "description": "AdamW hyperparameters (also used for AdamW side [1D and embedding/unembed params] when optimizer=muon, normuon, or muonh)"
        },
        "adam_beta2": {
          "type": "number",
          "default": 0.999
        },
        "adam_epsilon": {
          "type": "number",
          "default": 1e-08
        },
        "adam_learning_rate": {
          "type": "number",
          "default": 0.0001
        },
        "max_grad_norm": {
          "type": "number",
          "default": ".inf"
        },
        "repo_rope_warmup_steps": {
          "type": "integer",
          "default": 1000,
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true
        },
        "adam_weight_decay": {
          "type": "number",
          "default": 0.0
        },
        "muon_learning_rate": {
          "type": "number",
          "default": 0.001
        },
        "muon_weight_decay": {
          "type": "number",
          "default": 0.01
        },
        "muon_cautious_weight_decay": {
          "type": "boolean",
          "default": true
        },
        "muon_use_polar_express": {
          "type": "boolean",
          "default": true
        },
        "muon_momentum": {
          "type": "number",
          "default": 0.95
        },
        "muon_nesterov": {
          "type": "boolean",
          "default": true
        },
        "muon_eps": {
          "type": "number",
          "default": 1e-07
        },
        "muonh_normalization": {
          "type": "string",
          "default": "neuron",
          "enum": [
            "neuron",
            "short_axis",
            "none"
          ],
          "description": "used only when optimizer=muonh: neuron | short_axis | none"
        },
        "muonh_scope": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "mlp"
          ],
          "description": "used when optimizer=muonh|aurora: all = all matrices; mlp = MLP matrices only (rest on NorMuon)"
        },
        "noble_base_lr": {
          "type": "number",
          "default": 0.0003,
          "description": "NOBLE optimizer LR scaling (only used when model.use_noble=true) independent base LR for NOBLE branch params",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_lr_gamma": {
          "type": "number",
          "default": 0.3,
          "description": "W_up LR power (actual exponent = 2\u03b3 = 0.6)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_lr_gamma_M": {
          "type": "number",
          "default": 0.45,
          "description": "M mixing matrix LR power",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_freq_lr_mult": {
          "type": "number",
          "default": 3.0,
          "description": "\u03c9 frequency LR multiplier",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "noble_phase_lr_mult": {
          "type": "number",
          "default": 5.0,
          "description": "\u03c6 phase LR multiplier",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "use_noble",
            "op": "==",
            "value": true
          }
        },
        "recycling_bptt": {
          "type": "integer",
          "default": 8,
          "description": "Huginn-style recycling training-time options (active only when model.recycling_loop_count > 1) truncated BPTT depth K (last K iters get gradients)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_loop_count_sampling": {
          "type": "string",
          "default": "lognormal_poisson",
          "enum": [
            "fixed",
            "lognormal_poisson"
          ],
          "description": "fixed | lognormal_poisson",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
        "recycling_loop_count_sigma": {
          "type": "number",
          "default": 0.5,
          "description": "log-normal std (Huginn value)",
          "x-nanoplm-backend": [
            "pure_torch"
          ],
          "x-nanoplm-advanced": true,
          "x-nanoplm-visible-when": {
            "field": "recycling_loop_count",
            "op": ">",
            "value": 1
          }
        },
