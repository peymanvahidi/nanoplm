        padding: 1.1rem 1.15rem 1.35rem;
        overflow-x: auto;
        /* Sized so the longest log line clears a 390px phone without scrolling. */
        font-size: 0.7rem;
        line-height: 1.85;
      }
      @media (min-width: 30rem) {
        .term-body {
          font-size: 0.775rem;
        }
      }
      .term-body code {
        display: block;
        min-width: max-content;
      }
      .ln {
        display: block;
        white-space: pre;
      }
      /* The terminal keeps its dark chrome in light mode, so its text colours
         are literal rather than tokenised. All clear 4.5:1 on #10161a. */
      .ln-cmd {
        color: #e7edee;
        margin-top: 0.55rem;
      }
      .ln-cmd:first-child {
        margin-top: 0;
      }
      .ln-cmd::before {
        content: '$ ';
        color: #4fc3d9;
      }
      .ln-out {
        color: #93a1a1;
      }
      /* The two capability lines are the good news in the run, so they take the
         logo's sage rather than reading as ordinary output. */
      .ln-ok {
        color: #a2c46e;
      }
      .ln-log {
        color: #7fd8e8;
      }
      :global([data-theme='light']) .ln-out {
        color: #9aa8a8;
      }
      .caret {
        width: 0.5rem;
        height: 1rem;
        margin-top: 0.35rem;
        background: #4fc3d9;
      }
      @media (prefers-reduced-motion: no-preference) {
        .caret {
          animation: blink 1.15s steps(1) infinite;
        }
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }

      /* --- Amino acid strip -------------------------------------------------- */
      .strip {
        position: relative;
        border-block: 1px solid var(--sl-color-hairline-shade);
        padding-block: 0.7rem;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
      }
      .strip-track {
        display: flex;
        width: max-content;
        gap: 2rem;
        font-family: var(--sl-font-mono);
        font-size: 0.9rem;
        letter-spacing: 0.3em;
        /* The alphabet the tokenizer sees, running through the logo's own
           sweep. Decorative and aria-hidden, so it is held well below body
           contrast on purpose. */
        background: linear-gradient(
          90deg,
          var(--c-indigo),
          var(--c-azure),
          var(--c-cyan),
          var(--c-sage),
          var(--c-violet),
          var(--c-indigo)
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        opacity: 0.55;
        user-select: none;
      }
      @media (prefers-reduced-motion: no-preference) {
        .strip-track {
          animation: drift 64s linear infinite;
        }
      }
      @keyframes drift {
        to {
          transform: translateX(calc(-100% / 3 - 0.667rem));
        }
      }

      /* --- Facts ------------------------------------------------------------ */
      .facts {
        border-bottom: 1px solid var(--sl-color-hairline-shade);
      }
      .facts-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.75rem 1rem;
        padding-block: 2.5rem;
        text-align: center;
      }
      @media (min-width: 48rem) {
        .facts-grid {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .facts-grid b {
        display: block;
        font-size: 1.65rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--h);
      }
      .facts-grid span {
        display: block;
        margin-top: 0.2rem;
        font-size: 0.83rem;
        line-height: 1.45;
        color: var(--sl-color-gray-3);
      }

      /* --- Affiliations ------------------------------------------------------ */
      /* Only a top rule: the band closes against the border-bottom .facts
         already carries, so a border-block here would double the line. The
         tint is what stops a row of three logos from reading as an empty gap
         below the facts; three items cannot fill 72rem without looking
         stranded, so the band is given a floor instead of being stretched. */
      .affil {
        border-top: 1px solid var(--sl-color-hairline-shade);
        padding-block: 2rem;
        background: color-mix(in srgb, var(--sl-color-gray-6) 40%, var(--sl-color-bg));
      }
      :global([data-theme='light']) .affil {
        background: var(--sl-color-gray-6);
      }
      /* The column gap scales hard with the viewport on purpose. Three logos
         are only ~430px of artwork, so at a fixed gap they huddle in the middle
         of a 72rem shell and read as a leftover gap rather than a row; opening
         the gap carries them out to roughly half the shell instead. */
      .affil-logos {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 1.25rem clamp(1.5rem, 6vw, 5.5rem);
        /* margin-block only: this element is also .shell, and a blanket
           `margin: 0` would win on source order and kill its margin-inline:
           auto, pinning the row to the left edge instead of centring it. */
        margin-block: 0;
        list-style: none;
      }
      /* The artwork supplies the silhouette, the token supplies the colour, so
         all three read as one family and both themes are handled by swapping a
         single value. --r keeps each logo's own proportions; --k trims the
         dense ones so the row is optically even rather than merely equal-height. */
      /* Plain images, with the grey baked into the files themselves. An earlier
         version tinted the artwork with a CSS mask, which let one asset serve
         both themes but fails to a solid rectangle in Safari when the mask does
         not apply. #747a79 was chosen to clear 3:1 against both theme
         backgrounds, so the images are correct with no CSS colour work at all;
         the filters below only sharpen them, and losing those costs contrast
         rather than the logo.

         Height tracks the viewport: held at 3.5rem the row needs three stacked
         lines at 320px and the band grows past 300px tall, which is more space
         than an affiliations strip has any claim to. */
      .affil-logo {
        display: block;
        height: calc(clamp(2.125rem, 1.5rem + 3.125vw, 3.5rem) * var(--k, 1));
        width: auto;
        filter: brightness(1.19);
      }
      :global([data-theme='light']) .affil-logo {
        filter: brightness(0.78);
      }

      /* --- Section scaffolding ---------------------------------------------- */
      .band {
        padding-block: 5rem;
        scroll-margin-top: 4rem;
      }
      .band.alt {
        background: color-mix(in srgb, var(--sl-color-gray-6) 40%, var(--sl-color-bg));
        border-block: 1px solid var(--sl-color-hairline-shade);
      }
      :global([data-theme='light']) .band.alt {
        background: var(--sl-color-gray-6);
      }
      @media (min-width: 62rem) {
        .band {
          padding-block: 6.5rem;
        }
      }
      .sec-head {
        max-width: 44rem;
        margin: 0 auto 3rem;
        text-align: center;
      }
      .sec-head.left {
        margin-inline: 0;
        text-align: left;
      }
      .kicker {
        margin-bottom: 0.7rem;
        font-family: var(--sl-font-mono);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--sl-color-accent-high);
      }
      .sec-head h2 {
        font-size: clamp(1.6rem, 3.6vw, 2.3rem);
        line-height: 1.18;
        letter-spacing: -0.024em;
        font-weight: 700;
      }
      .sub {
        margin-top: 1rem;
        font-size: 1rem;
        line-height: 1.65;
        color: var(--sl-color-gray-2);
      }
      .sub code {
        padding: 0.1em 0.35em;
        border: 1px solid var(--sl-color-hairline-shade);
        border-radius: 0.25rem;
        background: var(--surface);
        font-size: 0.86em;
        color: var(--sl-color-accent-high);
      }
      .sec-foot {
        margin-top: 2rem;
        text-align: center;
      }
      .sec-head.left .sec-foot {
        text-align: left;
      }
      .textlink {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.75rem;
        font-size: 0.925rem;
        font-weight: 600;
        color: var(--sl-color-accent-high);
        text-decoration: none;
      }
      .textlink svg {
        width: 1rem;
        height: 1rem;
        transition: transform 0.18s ease;
      }
      .textlink:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
      }
      .textlink:hover svg {
        transform: translateX(3px);
      }

      /* --- The loop --------------------------------------------------------- */
      .loop {
        display: grid;
        gap: 1rem;
        counter-reset: loop;
      }
      /* Three across only once a card is wide enough for a whole command on one
         line. Below that the stacked layout wins, because a command clipped
         mid-word reads as broken in a way a taller card does not. */
      @media (min-width: 54rem) {
        .loop {
          grid-template-columns: repeat(3, 1fr);
        }
        .loop-code {
          font-size: 0.72rem;
        }
      }
      .loop li {
        position: relative;
        padding: 1.6rem 1.5rem;
        border: 1px solid var(--sl-color-hairline-shade);
        border-radius: 0.75rem;
        background: var(--surface);
      }
      /* A connector between the three steps, so they read as one loop rather
         than three unrelated cards. Wide screens only, where they sit in a row. */
      @media (min-width: 54rem) {
        .loop li:not(:last-child)::after {
          content: '';
          position: absolute;
          top: 2.55rem;
          right: -1rem;
          width: 1rem;
          border-top: 1px dashed var(--sl-color-gray-4);
        }
      }
      .loop-n {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.7rem;
        height: 1.7rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--h) 16%, transparent);
        font-family: var(--sl-font-mono);
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--h);
      }
      .loop h3 {
        margin-top: 0.85rem;
        font-size: 1.1rem;
        font-weight: 650;
        letter-spacing: -0.015em;
      }
      .loop p {
        margin-top: 0.4rem;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--sl-color-gray-3);
      }
      .loop-code {
        display: block;
        margin-top: 1.1rem;
        padding-top: 0.9rem;
        border-top: 1px solid var(--sl-color-hairline-shade);
        font-size: 0.76rem;
        color: var(--sl-color-gray-2);
        overflow-x: auto;
        white-space: nowrap;
      }
      .loop-code i {
        font-style: normal;
        color: var(--h);
      }

      /* --- Pipeline host ----------------------------------------------------- */
      /* PipelineDiagram is a container-query component sized for the 50rem prose
         column, so it is given exactly that much room and centred here. */
      .pipe-host {
        max-width: 54rem;
        margin-inline: auto;
      }

      /* --- Quickstart steps -------------------------------------------------- */
      .steps {
        display: grid;
        gap: 1rem;
      }
      @media (min-width: 56rem) {
        .steps {
          grid-template-columns: repeat(2, 1fr);
          gap: 1.25rem;
        }
      }
      .steps li {
        display: flex;
        flex-direction: column;
        padding: 1.6rem 1.5rem;
        border: 1px solid var(--sl-color-hairline-shade);
        border-radius: 0.75rem;
        background: var(--surface);
      }
      .step-head {
        display: flex;
        gap: 0.9rem;
      }
      .step-n {
        flex-shrink: 0;
        font-family: var(--sl-font-mono);
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1.7;
        color: var(--sl-color-accent);
      }
      .steps h3 {
        font-size: 1.1rem;
        font-weight: 650;
        letter-spacing: -0.015em;
      }
      .steps .step-head p {
        margin-top: 0.35rem;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--sl-color-gray-3);
      }
      .code-card {
        position: relative;
        margin-top: 1.2rem;
        border: 1px solid var(--sl-color-hairline-shade);
        border-radius: 0.55rem;
        background: color-mix(in srgb, var(--sl-color-bg) 70%, var(--surface-2));
      }
      :global([data-theme='light']) .code-card {
        background: #f2f6f6;
      }
      .code-card .copy {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        z-index: 1;
      }
      .code-card pre {
        margin: 0;
        padding: 0.9rem 3rem 0.9rem 1rem;
        overflow-x: auto;
        font-size: 0.775rem;
        line-height: 1.75;
        color: var(--sl-color-gray-1);
      }

      /* --- Feature cards ----------------------------------------------------- */
      .cards {
        display: grid;
        gap: 1rem;
      }
      @media (min-width: 44rem) {
        .cards {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (min-width: 68rem) {
        .cards {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .card {
        padding: 1.6rem 1.5rem;
        border: 1px solid var(--sl-color-hairline-shade);
        border-radius: 0.75rem;
        background: var(--surface);
        transition:
          border-color 0.18s ease,
          transform 0.18s ease;
      }
      :global([data-theme='light']) .card {
        box-shadow: 0 1px 2px rgba(20, 24, 28, 0.04);
      }
      .card:hover {
        border-color: color-mix(in srgb, var(--h) 55%, transparent);
      }
      @media (prefers-reduced-motion: no-preference) {
        .card:hover {
          transform: translateY(-2px);
        }
      }
      .card-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.35rem;
        height: 2.35rem;
        margin-bottom: 1rem;
        border: 1px solid color-mix(in srgb, var(--h) 32%, transparent);
        border-radius: 0.55rem;
        background: color-mix(in srgb, var(--h) 14%, transparent);
        color: var(--h);
      }
      .card-icon svg {
        width: 1.15rem;
        height: 1.15rem;
      }
      .card h3 {
        font-size: 1.05rem;
        font-weight: 650;
        letter-spacing: -0.015em;
      }
      .card p {
        margin-top: 0.5rem;
        font-size: 0.9rem;
        line-height: 1.62;
        color: var(--sl-color-gray-3);
      }

      /* --- Why ---------------------------------------------------------------- */
      .why {
        max-width: 44rem;
        margin-inline: auto;
      }
      .why p {
        margin-top: 1.15rem;
        font-size: 1.02rem;
        line-height: 1.72;
        color: var(--sl-color-gray-2);
      }
      .why p:first-child {
        margin-top: 0;
      }
      /* The thesis, set above a rule so it reads as the conclusion rather than
         a third paragraph. Qualified with p so it outranks `.why p` above. */
      .why p.why-punch {
        margin-top: 1.7rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--sl-color-hairline-shade);
        font-size: 1.1rem;
        color: var(--sl-color-white);
      }
      .why-punch strong {
        color: var(--c-cyan);
        font-weight: 650;
      }

      /* --- Requirements ------------------------------------------------------- */
      .install-grid {
        display: grid;
        gap: 2.5rem;
        align-items: start;
      }
      @media (min-width: 62rem) {
        .install-grid {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          gap: 4rem;
        }
      }
      .install-grid .sec-head {
        margin-bottom: 0;
      }
      .reqs {
        border: 1px solid var(--sl-color-hairline-shade);
        border-radius: 0.75rem;
        background: var(--surface);
        overflow: hidden;
      }
      .reqs > div {
        display: grid;
        grid-template-columns: 7rem minmax(0, 1fr);
        gap: 1rem;
        padding: 1rem 1.35rem;
        border-bottom: 1px solid var(--sl-color-hairline-shade);
      }
      .reqs > div:last-child {
        border-bottom: none;
      }
      .reqs dt {
        font-family: var(--sl-font-mono);
        font-size: 0.76rem;
        letter-spacing: 0.02em;
        color: var(--sl-color-gray-3);
        align-self: center;
      }
      .reqs dd {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--sl-color-white);
      }

      /* --- Closer ------------------------------------------------------------- */
      .closer {
        padding-block: 5.5rem;
        text-align: center;
      }
      .closer h2 {
        font-size: clamp(1.6rem, 3.6vw, 2.3rem);
        line-height: 1.18;
        letter-spacing: -0.024em;
        font-weight: 700;
      }
      .closer p {
        max-width: 34rem;
        margin: 1rem auto 0;
        font-size: 1rem;
        line-height: 1.65;
        color: var(--sl-color-gray-2);
      }

      /* --- Footer ------------------------------------------------------------- */
      .foot {
        border-top: 1px solid var(--sl-color-hairline-shade);
        background: color-mix(in srgb, var(--sl-color-gray-6) 40%, var(--sl-color-bg));
        padding-top: 3.5rem;
      }
      :global([data-theme='light']) .foot {
        background: var(--sl-color-gray-6);
      }
      .foot-inner {
        display: grid;
        gap: 2.5rem;
        padding-bottom: 3rem;
      }
      @media (min-width: 56rem) {
        .foot-inner {
          grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
          gap: 3rem;
        }
      }
      .foot-brand p {
        margin-top: 0.9rem;
        max-width: 18rem;
        font-size: 0.85rem;
        line-height: 1.55;
        color: var(--sl-color-gray-3);
      }
      .foot-cols {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem 1rem;
      }
      @media (min-width: 40rem) {
        .foot-cols {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .foot-cols h3 {
        margin-bottom: 0.8rem;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--sl-color-gray-3);
      }
      .foot-cols a {
        display: block;
        padding-block: 0.4rem;
        font-size: 0.875rem;
        color: var(--sl-color-gray-2);
        text-decoration: none;
        transition: color 0.18s ease;
      }
      .foot-cols a:hover {
        color: var(--sl-color-accent-high);
      }
      .foot-legal {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        padding-block: 1.35rem;
        border-top: 1px solid var(--sl-color-hairline-shade);
        font-size: 0.8rem;
        /* gray-4 lands at 3.3:1 here, under AA for body text, so this line uses
           the same grey as the other small print. */
        color: var(--sl-color-gray-3);
      }
      .to-top {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        color: var(--sl-color-gray-3);
        text-decoration: none;
      }
      .to-top:hover {
        color: var(--sl-color-accent-high);
      }

      /* --- Reveals ------------------------------------------------------------
         "Shown" is the default state, so no-JS and reduced-motion visitors get
         the finished page. The script adds .pre only when motion is welcome,
         then removes it as each element scrolls in. */
      .pre {
        opacity: 0;
        transform: translateY(14px);
      }
      [data-reveal],
      [data-reveal-seq] {
        transition:
          opacity 0.55s ease-out,
          transform 0.55s ease-out;
      }
      /* The terminal cascades its own lines once the card itself is revealed.
         Each line carries its index as --i, so the delay is a single rule
         rather than a dozen nth-child selectors. */
      [data-reveal-seq] .ln {
        opacity: 1;
        transition: opacity 0.32s ease-out;
        transition-delay: calc(55ms * var(--i, 0));
      }
      [data-reveal-seq].pre .ln {
        opacity: 0;
        transition-delay: 0s;
      }
    </style>
  </body>
</html>
