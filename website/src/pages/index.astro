---
// website/src/pages/index.astro
// The marketing front door. This is a plain Astro page rather than a Starlight
// docs page, because the landing layout (full-bleed hero, no sidebar, no ToC)
// fights every part of the docs chrome. Astro gives `src/pages` priority over
// Starlight's injected catch-all route, so this file owns "/" and the old docs
// index moved to /start/what-is-nanoplm/.
//
// It still imports the docs stylesheet, so every colour, font and light/dark
// override comes from the one place that already defines them. Nothing about
// the palette is restated here; if custom.css changes, this page follows.
import fs from 'node:fs';
import { Image } from 'astro:assets';
import logo from '../assets/nanoplm-logo.png';
import tumLogo from '../assets/logo-tum.svg';
import helmholtzLogo from '../assets/logo-helmholtz-munich.png';
import julichLogo from '../assets/logo-julich.png';
import PipelineDiagram from '../components/PipelineDiagram.astro';
import '../styles/custom.css';

// BASE_URL is "/nanoplm/" in production and "/" in a bare dev server. Strip the
// trailing slash once so every link below can be written as `${base}/path/`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const GITHUB = 'https://github.com/peymanvahidi/nanoplm';
const PYPI = 'https://pypi.org/project/nanoplm/';

// Read the version from the package metadata instead of hardcoding it. The docs
// already generate their reference tables from the source of truth so they
// cannot go stale; the one number on the landing page should not be the
// exception that quietly rots.
let version = '';
try {
  const pyproject = fs.readFileSync(new URL('../../../pyproject.toml', import.meta.url), 'utf8');
  version = pyproject.match(/^version\s*=\s*"([^"]+)"/m)?.[1] ?? '';
} catch {
  // A missing pyproject only costs us the version chip, so render without it.
}

const title = 'nanoPLM: from FASTA to a protein language model';
const description =
  'nanoPLM pretrains a protein language model from a FASTA file. Three YAML files, six commands, and reproducible artifacts that flow between them.';
const ogImage = new URL(logo.src, Astro.site).href;

// The quickstart, split so each block gets its own copy button. These are the
// same commands as the install docs; the section links there for the full story
// (clusters, verification, the eval extra) rather than duplicating it.
const STEPS = [
  {
    n: '01',
    title: 'Install',
    body: 'One pinned GPU stack: torch, Transformer Engine, FlashAttention-3, SonicMoE and Dion.',
    code: `uv venv && source .venv/bin/activate
uv pip install "nanoplm @ git+https://github.com/peymanvahidi/nanoplm" \\
    --extra-index-url https://download.pytorch.org/whl/cu130
nanoplm deps install`,
  },
  {
    n: '02',
    title: 'Prepare data',
    body: 'FASTA in, tokenized shards out, tracked by DVC and described by a manifest.',
    code: `nanoplm data get-yaml
nanoplm data from-yaml`,
  },
  {
    n: '03',
    title: 'Pretrain',
    body: 'Shards in, a checkpoint out. The manifest tells pretraining what the data stage decided.',
    code: `nanoplm pretrain get-yaml
nanoplm pretrain from-yaml`,
  },
  {
    n: '04',
    title: 'Evaluate',
    body: 'A checkpoint in, benchmark scores out, via biotrainer’s autoeval pipeline.',
    code: `nanoplm eval get-yaml
nanoplm eval from-yaml`,
  },
];

// `hue` walks the logo left to right, so the six cards together replay the
// wordmark's own sweep rather than repeating one accent six times.
const FEATURES = [
  {
    hue: 'indigo',
    icon: 'sliders',
    title: 'Configured, not coded',
    body: 'Three commented YAML files control the whole pipeline. Scaffold one with get-yaml, edit it, run it with from-yaml. No training script to fork and maintain.',
  },
  {
    hue: 'azure',
    icon: 'file-check',
    title: 'Artifacts that describe themselves',
    body: 'The data stage writes a .data_manifest recording what it decided. Checkpoints carry their own model_config.yaml. You never retype a setting to hand it to the next stage.',
  },
  {
    hue: 'cyan',
    icon: 'git-branch',
    title: 'Data you can trust',
    body: 'DVC runs under the hood, so every dataset you build is versioned and reproducible. Rerun a month-old experiment and get the same shards.',
  },
  {
    hue: 'sage',
    icon: 'cpu',
    title: 'Serious kernels, quietly',
    body: 'FP8 through Transformer Engine, FlashAttention-3, token packing, SonicMoE and the Dion optimizer family are installed and wired up. Turn them on with a config key.',
  },
  {
    hue: 'violet',
    icon: 'zap',
    title: 'Native fast paths',
    body: 'Tokenizing and shard writing drop to an OpenMP-enabled C backend, as do FASTA shuffle, filter and split. Both fall back to Python when unavailable.',
  },
  {
    hue: 'azure',
    icon: 'shield-check',
    title: 'Reference that cannot drift',
    body: 'Every key of every config is generated from the get-yaml templates and the config dataclasses, and CI fails when they disagree with the docs.',
  },
];

const REQUIREMENTS = [
  { label: 'OS / CPU', value: 'Linux x86_64 or aarch64' },
  { label: 'GPU', value: 'NVIDIA Hopper (H100, H200, GH200, sm90)' },
  { label: 'CUDA', value: '13.0 or newer' },
  { label: 'Python', value: '3.11 to 3.13, tested on 3.12' },
];

// Decorative only, and hidden from assistive tech. Twenty proteinogenic amino
// acid letters in the alphabet nanoPLM actually tokenizes, repeated to fill a
// marquee. It is a texture, not a real sequence, so it makes no claim.
const ALPHABET = 'MKTAYIAKQRQISFVKSHFSRQLEERLGLIEVQAPILSRVGDGTQDNLSGAEKAVQVKVKALPDAQFEVVHSLAKWKR';

// The institutions behind the project. Each source shipped in its own palette
// and its own format, so all three were flattened to one grey (#747a79) in the
// asset files themselves rather than tinted in CSS. `k` is an optical scale,
// since matching heights would leave the dense TUM monogram looking heavier
// than the two wordmarks beside it.
const AFFILIATIONS = [
  { img: tumLogo, k: 0.85, name: 'Technical University of Munich' },
  { img: helmholtzLogo, k: 0.94, name: 'Helmholtz Munich' },
  { img: julichLogo, k: 0.95, name: 'Forschungszentrum Jülich' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(base + '/', Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* Inlined and first so the theme lands before paint, exactly like
        Starlight's own ThemeProvider. It reads the same localStorage key, which
        is what makes the preference survive the trip between here and the docs. */}
    <script is:inline>
      (() => {
        const stored =
          typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
        const theme =
          stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="shell nav-inner">
        <a class="brand" href={`${base}/`} aria-label="nanoPLM home">
          <Image src={logo} alt="nanoPLM" height={27} densities={[1, 2]} loading="eager" />
        </a>

        <nav class="nav-links" aria-label="Page sections">
          <a href="#why">Why</a>
          <a href="#pipeline">How it works</a>
          <a href="#features">Features</a>
          <a href="#install">Install</a>
        </nav>

        <div class="nav-actions">
          <a class="btn btn-ghost" href={`${base}/start/install/`}>Docs</a>
          <a class="icon-btn" href={GITHUB} aria-label="nanoPLM on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
              ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
            >
          </a>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle colour theme">
            <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"
              ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"
              ></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"
              ></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path
                d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg
            >
            <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
            >
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- ================= HERO ================= -->
      <section class="hero">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              <span class="dot" aria-hidden="true"></span>
              Encoder-only protein language models
              {version && <span class="ver">v{version}</span>}
            </p>

            {/* Broken by hand into three lines. Left to wrap on its own the
                article "a" ends up orphaned on a line of its own, and the
                headline is short enough that these breaks hold down to 320px. */}
            <h1>
              From FASTA to a<br />
              <span class="grad">Foundation&nbsp;Model</span>.<br />
              Fast.
            </h1>

            <p class="lede">
              Pretraining a protein language model no longer needs hundreds of GPUs. It needs
              tooling. nanoPLM is a batteries-included pipeline: three YAML files, six commands,
              and reproducible artifacts that flow between them.
            </p>

            <div class="cta-row">
              <a class="btn btn-primary" href={`${base}/start/first-plm/`}>
                Train your first PLM
                <svg viewBox="0 0 24 24" aria-hidden="true"
                  ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
                >
              </a>
              <a class="btn btn-outline" href={GITHUB}>
                <svg viewBox="0 0 24 24" aria-hidden="true"
                  ><path
                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                  ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
                >
                Star on GitHub
              </a>
            </div>

            <div class="install-line">
              <code>uv pip install nanoplm &amp;&amp; nanoplm deps install</code>
              <button
                class="copy"
                type="button"
                data-copy="uv pip install nanoplm && nanoplm deps install"
                aria-label="Copy install command"
              >
                <svg class="i-copy" viewBox="0 0 24 24" aria-hidden="true"
                  ><rect width="14" height="14" x="8" y="8" rx="2"></rect><path
                    d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg
                >
                <svg class="i-check" viewBox="0 0 24 24" aria-hidden="true"
                  ><path d="M20 6 9 17l-5-5"></path></svg
                >
              </button>
            </div>
            <p class="fineprint">
              Hopper GPU and CUDA 13 required. <a href={`${base}/start/install/`}>Full install</a>.
            </p>
          </div>

          <!-- A real session, not a mockup of one: these are the commands from
               the quickstart and the log lines the pretrain loop actually
               prints. The lines fade in one by one on load, and appear at once
               when reduced motion is requested. -->
          <div class="term" data-reveal-seq>
            <div class="term-bar" aria-hidden="true">
              <span class="tl tl-r"></span><span class="tl tl-y"></span><span class="tl tl-g"></span>
              <span class="term-title">nanoplm</span>
            </div>
            <pre class="term-body"><code>{[
              { t: 'cmd', v: 'nanoplm data get-yaml' },
              { t: 'out', v: 'wrote data.yaml, dvc.yaml' },
              { t: 'cmd', v: 'nanoplm data from-yaml' },
              { t: 'out', v: 'train.fasta  val.fasta' },
              { t: 'out', v: 'shard_*.bin  .data_manifest' },
              { t: 'cmd', v: 'nanoplm pretrain from-yaml' },
              { t: 'out', v: 'Using pure-torch model and training loop' },
              { t: 'ok', v: 'Total Trainable Parameters: 2306848' },
              { t: 'ok', v: 'Flash attention available: True' },
              { t: 'log', v: '[step 1/154] loss=3.4412 lr=5.00e-06 tok/s=412,190' },
              { t: 'log', v: '[step 2/154] loss=3.3901 lr=1.00e-05 tok/s=418,004' },
              { t: 'log', v: '[step 3/154] loss=3.2118 lr=1.50e-05 tok/s=420,771' },
            ].map((l, i) => (
              <span class={`ln ln-${l.t}`} style={`--i:${i}`}>{l.v}</span>
            ))}<span class="ln caret" aria-hidden="true"></span></code></pre>
          </div>
        </div>

        <!-- Amino acid texture: the alphabet the tokenizer sees, masked to
             nothing at both edges so it reads as material rather than content. -->
        <div class="strip" aria-hidden="true">
          <div class="strip-track">
            <span>{ALPHABET}</span><span>{ALPHABET}</span><span>{ALPHABET}</span>
          </div>
        </div>
      </section>

      <!-- ================= FACTS ================= -->
      <section class="facts">
        <div class="shell facts-grid">
          {
            [
              { hue: 'indigo', n: '3', label: 'YAML files control everything' },
              { hue: 'cyan', n: '6', label: 'commands, FASTA to benchmark' },
              { hue: 'sage', n: 'FP8', label: 'Transformer Engine and FA-3' },
              { hue: 'violet', n: 'MIT', label: 'open source, built in the open' },
            ].map((f) => (
              <div style={`--h: var(--c-${f.hue})`}>
                <b>{f.n}</b>
                <span>{f.label}</span>
              </div>
            ))
          }
        </div>

        <!-- Same banded treatment as the hero strip, but static: a logo the
             reader has to chase across the screen defeats the point of showing
             it. No caption, so each alt string is the only thing naming these
             institutions. -->
        <div class="affil">
          <ul class="shell affil-logos">
            {
              AFFILIATIONS.map((a) => (
                <li>
                  <img
                    class="affil-logo"
                    style={`--k: ${a.k}`}
                    src={a.img.src}
                    width={a.img.width}
                    height={a.img.height}
                    alt={a.name}
                    loading="lazy"
                    decoding="async"
                  />
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ================= WHY =================
           Placed directly after the hero on purpose: this is the problem the
           project exists to solve, so it frames every how-to section below it
           rather than arriving as an afterthought at the bottom of the page. -->
      <section class="band" id="why">
        <div class="shell">
          <header class="sec-head" data-reveal>
            <p class="kicker">Why we built it</p>
            <h2>The bottleneck is no longer compute</h2>
          </header>

          <div class="why" data-reveal>
            <p>
              Protein language modelling borrowed its playbook from natural language processing,
              then fell behind it. New architectures, optimizers and training methods land in NLP
              almost weekly, while protein models see a new state of the art every year or two.
            </p>
            <p>
              That gap is not a shortage of scientific interest. Training a pLM from scratch means
              multi-GPU setups, input pipelines fast enough to keep the GPUs fed, batch
              construction, sequence packing, and a long tail of choices that sit well outside most
              computational biologists' day job. So the realistic options are months of
              infrastructure work before the actual research question, or fine-tuning a model
              someone else trained. Plenty of questions cannot be answered that way.
            </p>
            <p class="why-punch">
              A strong pLM now trains on a handful of GPUs, a scale many academic labs already
              have. <strong>What is missing is the tooling.</strong>
            </p>
          </div>
        </div>
      </section>

      <!-- ================= THE LOOP ================= -->
      <section class="band alt" id="loop">
        <div class="shell">
          <header class="sec-head" data-reveal>
            <p class="kicker">The loop</p>
            <h2>Every stage has the same two verbs</h2>
            <p class="sub">
              Learn the loop once and you know the whole tool. <code>get-yaml</code> scaffolds a
              fully commented config, you edit it, <code>from-yaml</code> runs it. Shown for
              pretraining; swap in <code>data</code> or <code>eval</code> and the shape is identical.
            </p>
          </header>

          <ol class="loop" data-reveal>
            <li style="--h: var(--c-indigo)">
              <span class="loop-n">1</span>
              <h3>Scaffold</h3>
              <p>A config with every key explained in place, written to your working directory.</p>
              <code class="loop-code"><i>$</i> nanoplm pretrain get-yaml</code>
            </li>
            <li style="--h: var(--c-cyan)">
              <span class="loop-n">2</span>
              <h3>Edit</h3>
              <p>Change what your experiment needs. Every field is commented in place, so you rarely leave the file.</p>
              <code class="loop-code"><i>#</i> $EDITOR pretrain.yaml</code>
            </li>
            <li style="--h: var(--c-violet)">
              <span class="loop-n">3</span>
              <h3>Run</h3>
              <p>The config is the run. Rerunning the same file reproduces the same result.</p>
              <code class="loop-code"><i>$</i> nanoplm pretrain from-yaml</code>
            </li>
          </ol>
        </div>
      </section>

      <!-- ================= PIPELINE ================= -->
      <section class="band" id="pipeline">
        <div class="shell">
          <header class="sec-head" data-reveal>
            <p class="kicker">The pipeline</p>
            <h2>Three stages, and the files they hand each other</h2>
            <p class="sub">
              Because each stage describes itself on disk, you never repeat yourself. Data writes a
              manifest that pretraining reads back. Pretraining writes checkpoints that carry their
              own config, so evaluation needs nothing but a path.
            </p>
          </header>

          <div class="pipe-host" data-reveal>
            <PipelineDiagram />
          </div>

          <p class="sec-foot" data-reveal>
            <a class="textlink" href={`${base}/pipeline/`}>
              How the pipeline fits together
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
              >
            </a>
          </p>
        </div>
      </section>

      <!-- ================= QUICKSTART ================= -->
      <section class="band alt" id="quickstart">
        <div class="shell">
          <header class="sec-head" data-reveal>
            <p class="kicker">Quickstart</p>
            <h2>Zero to a trained model</h2>
            <p class="sub">
              The defaults are wired to chain: <code>data.yaml</code> writes shards exactly where
              <code>pretrain.yaml</code> looks for them. The one value the defaults cannot guess is
              <code>eval.checkpoint_dir</code>, so point that at the run you just trained.
            </p>
          </header>

          <ol class="steps">
            {
              STEPS.map((s) => (
                <li data-reveal>
                  <div class="step-head">
                    <span class="step-n">{s.n}</span>
                    <div>
                      <h3>{s.title}</h3>
                      <p>{s.body}</p>
                    </div>
                  </div>
                  <div class="code-card">
                    <button class="copy" type="button" data-copy={s.code} aria-label={`Copy the ${s.title.toLowerCase()} commands`}>
                      <svg class="i-copy" viewBox="0 0 24 24" aria-hidden="true">
                        <rect width="14" height="14" x="8" y="8" rx="2" />
                        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                      </svg>
                      <svg class="i-check" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </button>
                    <pre><code>{s.code}</code></pre>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- ================= FEATURES ================= -->
      <section class="band" id="features">
        <div class="shell">
          <header class="sec-head" data-reveal>
            <p class="kicker">What you get</p>
            <h2>Opinionated where it saves you time</h2>
          </header>

          <div class="cards">
            {
              FEATURES.map((f) => (
                <article class="card" data-reveal style={`--h: var(--c-${f.hue})`}>
                  <span class="card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      {f.icon === 'sliders' && (
                        <>
                          <path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3" />
                          <path d="M14 2v4M8 10v4M16 18v4" />
                        </>
                      )}
                      {f.icon === 'file-check' && (
                        <>
                          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                          <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                          <path d="m9 15 2 2 4-4" />
                        </>
                      )}
                      {f.icon === 'git-branch' && (
                        <>
                          <path d="M6 3v12" />
                          <circle cx="18" cy="6" r="3" />
                          <circle cx="6" cy="18" r="3" />
                          <path d="M18 9a9 9 0 0 1-9 9" />
                        </>
                      )}
                      {f.icon === 'cpu' && (
                        <>
                          <rect width="16" height="16" x="4" y="4" rx="2" />
                          <rect width="6" height="6" x="9" y="9" rx="1" />
                          <path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" />
                        </>
                      )}
                      {f.icon === 'zap' && (
                        <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />
                      )}
                      {f.icon === 'shield-check' && (
                        <>
                          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                          <path d="m9 12 2 2 4-4" />
                        </>
                      )}
                    </svg>
                  </span>
                  <h3>{f.title}</h3>
