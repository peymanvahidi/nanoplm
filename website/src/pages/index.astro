    <script>
      // Copy buttons. The button swaps to a check for a moment, which is the
      // only feedback a copy action can honestly give.
      document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? '');
            btn.classList.add('copied');
            setTimeout(() => btn.classList.remove('copied'), 1600);
          } catch {
            // Clipboard access can be denied; the text is selectable anyway.
          }
        });
      });

      // Theme toggle, writing the key Starlight reads so the choice carries
      // over to the docs and back.
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {
          // Private mode can block storage; the toggle still works for this page.
        }
      });

      // Scroll reveals and the terminal line cascade. Both are opacity and
      // transform only, both are skipped entirely when the visitor asks for
      // reduced motion, and in that case the markup is already in its final
      // state because "shown" is the default and JS only removes the pre-state.
      const wantsMotion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
      if (wantsMotion && 'IntersectionObserver' in window) {
        const targets = Array.from(
          document.querySelectorAll('[data-reveal], [data-reveal-seq]')
        );
        // Only pre-hide what is still below the fold. Whatever is already on
        // screen when this runs (including after a jump straight to an #anchor)
        // is left alone, so the first paint is never a blank section.
        const hidden = targets.filter(
          (el) => el.getBoundingClientRect().top > window.innerHeight * 0.9
        );
        hidden.forEach((el) => el.classList.add('pre'));

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.remove('pre');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        hidden.forEach((el) => io.observe(el));

        // Failsafe. An animation is a nice-to-have; content that never appears
        // is a broken page, so anything still hidden well after load is shown
        // regardless of what the observer did.
        setTimeout(() => hidden.forEach((el) => el.classList.remove('pre')), 6000);
      }
    </script>

